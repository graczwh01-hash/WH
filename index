<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>แบบประเมินการส่งวัสดุสิ้นเปลือง</title>
<style>
  :root{
    --ink:#22301d;
    --muted:#5c6b56;
    --paper:#ffffff;
    --card:#ffffff;
    --line:#d9ecc9;
    --brand-dark:#3f7d24;
    --brand:#5aa233;
    --brand-light:#82bd5c;
    --brand-pale:#e9f5df;
    --danger:#a8482f;
    --ok:#4f9c2e;
    --radius:16px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:"Sarabun","Noto Sans Thai",system-ui,-apple-system,sans-serif;
    line-height:1.5;
    padding:24px 0 60px;
  }
  .wrap{max-width:820px;margin:0 auto;padding:0 18px;}

  /* logo */
  .logo-row{
    margin-bottom:18px;
  }
  .logo-row .logo-card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:14px 26px;
    box-shadow:0 2px 8px rgba(63,125,58,.08);
    display:flex;
    justify-content:center;
  }
  .logo-row img{
    height:78px;
    width:auto;
    display:block;
  }

  /* banner */
  .banner{
    background:linear-gradient(120deg, var(--brand-dark) 0%, var(--brand) 60%, #4c9129 100%);
    border-radius:var(--radius);
    color:#fff;
    padding:22px 24px;
    display:flex;
    flex-wrap:wrap;
    gap:18px;
    align-items:center;
    justify-content:space-between;
    margin-bottom:18px;
    box-shadow:0 8px 20px rgba(79,156,46,.2);
  }
  .banner-left h1{
    margin:0 0 6px;
    font-size:23px;
    font-weight:700;
    line-height:1.3;
  }
  .banner-left p{
    margin:0;
    font-size:13.5px;
    color:#e4f2dd;
  }
  .banner-right{
    background:#fff;
    border-radius:12px;
    padding:14px 16px;
    display:flex;
    flex-direction:column;
    gap:10px;
    min-width:240px;
    flex:1 1 240px;
    max-width:320px;
  }
  .mini-field label{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:12.5px;
    color:var(--muted);
    margin-bottom:4px;
    font-weight:600;
  }
  .mini-field label .req{color:var(--danger);}
  .mini-field input{
    width:100%;
    border:none;
    border-bottom:1.5px dotted #c4d6bb;
    padding:2px 0 5px;
    font-size:14.5px;
    font-family:inherit;
    color:var(--ink);
    background:transparent;
  }
  .mini-field input:focus{outline:none;border-bottom-color:var(--brand);}
  .mini-field.invalid label{color:var(--danger);}
  .mini-field.invalid input{border-bottom-color:var(--danger);}

  /* info note */
  .info-note{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:15px;
    font-weight:400;
    color:#000;
    margin:0 4px 14px;
  }
  .info-note svg{flex:none;width:22px;height:22px;}

  /* table card */
  .table-card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    overflow:hidden;
    margin-bottom:18px;
  }
  .table-scroll{overflow-x:auto;}
  table.eval-table{
    width:100%;
    border-collapse:collapse;
    min-width:600px;
  }
  .eval-table thead tr.top-head{
    background:linear-gradient(90deg, var(--brand-dark) 0%, var(--brand) 100%);
  }
  .eval-table thead th{
    background:transparent;
    color:#fff;
    font-weight:700;
    font-size:12.5px;
    padding:10px 6px;
    text-align:center;
    border-bottom:1px solid var(--brand-dark);
    text-shadow:0 1px 2px rgba(0,0,0,.18);
  }
  .eval-table thead tr.top-head th{
    padding:11px 6px;
    font-size:13px;
  }
  .eval-table thead tr.sub-head{
    background:linear-gradient(90deg, var(--brand-dark) 0%, var(--brand) 50%, var(--brand-dark) 100%);
  }
  .eval-table thead tr.sub-head th{
    background:transparent;
    font-weight:700;
    padding:9px 4px 10px;
  }
  .eval-table thead tr.sub-head th:first-child,
  .eval-table thead tr.sub-head th:nth-child(2){
    border-right:1px solid rgba(255,255,255,.35);
  }
  .eval-table thead tr.sub-head th .n{
    display:block;
    font-size:15px;
    font-weight:800;
  }
  .eval-table thead tr.sub-head th .t{
    display:block;
    font-size:10.5px;
    font-weight:500;
    opacity:.95;
    margin-top:1px;
  }
  .eval-table th.col-num{width:44px;border-right:1px solid rgba(255,255,255,.35);}
  .eval-table th.col-topic{text-align:left;padding-left:14px;border-right:1px solid rgba(255,255,255,.35);}
  .eval-table td{
    border-bottom:1px solid var(--line);
    padding:12px 6px;
    text-align:center;
    vertical-align:middle;
  }
  .eval-table tbody tr:last-child td{border-bottom:none;}
  .eval-table tbody tr:nth-child(even){background:#fafdf8;}

  td.num-cell{
    text-align:center;
    border-right:1px solid var(--line);
  }
  .num-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:26px;height:26px;
    border-radius:50%;
    background:var(--brand);
    color:#fff;
    font-size:12.5px;
    font-weight:800;
  }
  td.topic-cell{
    text-align:left;
    padding-left:14px;
    display:flex;
    align-items:center;
    gap:10px;
    border-right:1px solid var(--line);
  }
  .icon-badge{
    flex:none;
    width:36px;height:36px;
    border-radius:50%;
    background:var(--brand-pale);
    color:var(--brand-dark);
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .icon-badge svg{width:19px;height:19px;}
  .qtext{
    font-size:14px;
    font-weight:600;
    color:var(--ink);
  }
  .err-text{
    display:none;
    font-size:11.5px;
    color:var(--danger);
    margin-top:3px;
    font-weight:500;
  }
  tr.criterion.invalid .err-text{display:block;}
  tr.criterion.invalid td{background:#fdf5f2;}
  tr.criterion.invalid .num-badge{background:var(--danger);}

  .radio-cell{
    display:inline-flex;
    cursor:pointer;
  }
  .radio-cell input{position:absolute;opacity:0;width:0;height:0;}
  .radio-cell .dot{
    width:24px;height:24px;
    border-radius:50%;
    border:2px solid #c7d9bd;
    display:inline-block;
    position:relative;
    transition:border-color .12s, background .12s;
  }
  .radio-cell input:checked + .dot{
    border-color:var(--brand);
    background:var(--brand);
    box-shadow:inset 0 0 0 4px #fff;
  }
  .radio-cell input:focus-visible + .dot{
    outline:2px solid var(--brand);
    outline-offset:2px;
  }

  /* card generic (department/date fallback not used, comments + footer) */
  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:18px 20px 20px;
    margin-bottom:16px;
  }
  .card h2{
    font-size:15px;
    margin:0 0 10px;
    color:var(--brand-dark);
    font-weight:700;
    display:flex;
    align-items:center;
    gap:7px;
  }
  .card h2 svg{color:var(--brand);}
  textarea{
    width:100%;
    border:1px solid var(--line);
    border-radius:8px;
    padding:10px 12px;
    font-size:15px;
    font-family:inherit;
    background:#fdfefb;
    color:var(--ink);
    resize:vertical;
    min-height:80px;
  }
  textarea:focus{
    outline:2px solid var(--brand);
    outline-offset:1px;
    border-color:var(--brand);
  }

  .thanks{
    display:flex;
    align-items:flex-start;
    gap:12px;
    background:var(--brand-pale);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:16px 18px;
    margin-bottom:20px;
  }
  .thanks .icon-badge{background:var(--brand);color:#fff;}
  .thanks h3{margin:0 0 3px;font-size:14.5px;color:var(--brand-dark);}
  .thanks p{margin:0;font-size:13px;color:var(--muted);}

  .submit-row{
    position:sticky;
    bottom:0;
    background:linear-gradient(to top, var(--paper) 60%, transparent);
    padding:18px 0 6px;
  }
  button#submitBtn{
    width:100%;
    background:var(--brand);
    color:#fff;
    border:none;
    border-radius:10px;
    padding:14px 18px;
    font-size:16px;
    font-weight:700;
    font-family:inherit;
    cursor:pointer;
    transition:background .15s;
  }
  button#submitBtn:hover{background:var(--brand-dark);}
  button#submitBtn:disabled{background:#9ab08f;cursor:not-allowed;}

  #status{
    margin-top:12px;
    padding:12px 14px;
    border-radius:8px;
    font-size:14px;
    display:none;
  }
  #status.show{display:block;}
  #status.ok{background:#eaf4e3;color:var(--ok);border:1px solid #c7d9c3;}
  #status.err{background:#f6e9e5;color:var(--danger);border:1px solid #e2c3b8;}

  footer.foot{
    text-align:center;
    font-size:12px;
    color:#a2ad99;
    margin-top:10px;
  }

  @media (max-width:560px){
    .banner{padding:18px;}
    .banner-right{max-width:none;width:100%;}
  }
</style>
</head>
<body>

<div class="wrap">
  <div class="logo-row">
    <div class="logo-card">
    <img src="data:image/png;base64," alt="gracz โลโก้">
    </div>
  </div>

  <form id="evalForm">

    <div class="banner">
      <div class="banner-left">
        <h1>แบบประเมินการส่งวัสดุสิ้นเปลือง</h1>
        <p>เพื่อพัฒนาคุณภาพการให้บริการอย่างต่อเนื่อง</p>
      </div>
      <div class="banner-right">
        <div class="mini-field" id="field_evalDate">
          <label for="evalDate">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            วันที่ประเมิน <span class="req">*</span>
          </label>
          <input type="date" id="evalDate" name="evalDate">
          <p class="err-text">กรุณาเลือกวันที่ประเมิน</p>
        </div>
        <div class="mini-field" id="field_department">
          <label for="department">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 22v-4h6v4M9 8h1M14 8h1M9 12h1M14 12h1"/></svg>
            หน่วยงาน/ผู้รับวัสดุ <span class="req">*</span>
          </label>
          <input type="text" id="department" name="department" placeholder="เช่น ฝ่ายผลิต">
          <p class="err-text">กรุณากรอกหน่วยงาน/ผู้รับวัสดุ</p>
        </div>
      </div>
    </div>

    <p class="info-note">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v5h1"/></svg>
      โปรดทำเครื่องหมายในช่องระดับคะแนนที่ตรงกับความเห็นของท่านมากที่สุด
    </p>

    <div class="table-card">
      <div class="table-scroll">
        <table class="eval-table">
          <thead>
            <tr class="top-head">
              <th class="col-num">ลำดับ</th>
              <th class="col-topic">หัวข้อประเมิน</th>
              <th colspan="5">ระดับคะแนน (โปรดเลือกเพียง 1 ระดับ)</th>
            </tr>
            <tr class="sub-head">
              <th></th>
              <th></th>
              <th><span class="n">5</span><span class="t">ดีมาก</span></th>
              <th><span class="n">4</span><span class="t">ดี</span></th>
              <th><span class="n">3</span><span class="t">ปานกลาง</span></th>
              <th><span class="n">2</span><span class="t">ต้องปรับปรุง</span></th>
              <th><span class="n">1</span><span class="t">ต้องปรับปรุงมาก</span></th>
            </tr>
          </thead>
          <tbody id="criteriaBody"></tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
        ข้อเสนอแนะเพิ่มเติม
      </h2>
      <textarea id="comments" name="comments" placeholder="ความคิดเห็น / ข้อเสนอแนะ (ถ้ามี)"></textarea>
    </div>

    <div class="thanks">
      <span class="icon-badge">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 8.5a3.5 3.5 0 117 0M3 21l4-4M21 21l-4-4M3 21c1-4 4-6 9-6s8 2 9 6"/></svg>
      </span>
      <div>
        <h3>ขอบคุณสำหรับการประเมิน</h3>
        <p>ความคิดเห็นของท่านจะเป็นประโยชน์อย่างยิ่งในการพัฒนาการให้บริการของเรา</p>
      </div>
    </div>

    <div class="submit-row">
      <button type="submit" id="submitBtn">บันทึกแบบประเมิน</button>
      <div id="status"></div>
    </div>
  </form>
</div>

<footer class="foot"></footer>

<script>
  // ตั้งค่า URL ของ Google Apps Script Web App ที่นี่
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwT_yfZt0zHNkpTJc_AGpbqQOsMZx92MsRmREOBzjlc9vkB9AJxEBQ1rP9lkNXuLV4V/exec";

  const CRITERIA = [
    "ความถูกต้องของวัสดุที่ส่ง",
    "จำนวนวัสดุครบถ้วนตามใบเบิก",
    "วัสดุอยู่ในสภาพสมบูรณ์",
    "การบรรจุ/แพ็ควัสดุเหมาะสม",
    "ติดฉลาก/ระบุรายละเอียดถูกต้อง",
    "ส่งมอบตรงตามกำหนดเวลา",
    "ความรวดเร็วในการให้บริการ",
    "ความสะอาดและความเป็นระเบียบ",
    "การประสานงานกับผู้รับ",
    "ความพึงพอใจโดยรวม"
  ];

  // ไอคอน SVG (line-style) หนึ่งอันต่อหัวข้อ
  const ICONS = [
    '<path d="M21 8L12 3 3 8l9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>',
    '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 3h6v2H9z"/><path d="M9 9h6M9 13h6M9 17h4"/>',
    '<path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/>',
    '<rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 001 1h12a1 1 0 001-1V8"/><path d="M10 12h4"/>',
    '<path d="M20 12l-8 8-9-9V4h7z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
    '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/>',
    '<rect x="1" y="7" width="13" height="9" rx="1"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="5.5" cy="18" r="1.6"/><circle cx="16.5" cy="18" r="1.6"/>',
    '<path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5z"/><path d="M19 15l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>',
    '<path d="M21 12a8 8 0 10-3.6 6.7L21 20l-1-3.6A7.96 7.96 0 0021 12z"/>',
    '<path d="M7 11v9H4v-9h3zm3 9h7.5a2 2 0 002-1.6L21 12a2 2 0 00-2-2.4h-4.4l.6-3.4A2 2 0 0013.3 4L10 9v11z"/>'
  ];

  const SCALE_VALUES = [5,4,3,2,1];

  const tbody = document.getElementById('criteriaBody');
  CRITERIA.forEach((text, i) => {
    const idx = i + 1;
    const tr = document.createElement('tr');
    tr.className = 'criterion';

    const tdNum = document.createElement('td');
    tdNum.className = 'num-cell';
    tdNum.innerHTML = `<span class="num-badge">${idx}</span>`;
    tr.appendChild(tdNum);

    const tdTopic = document.createElement('td');
    tdTopic.className = 'topic-cell';
    tdTopic.innerHTML = `
      <span class="icon-badge">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[i]}</svg>
      </span>
      <span>
        <span class="qtext">${text}</span>
        <p class="err-text">กรุณาให้คะแนนหัวข้อนี้</p>
      </span>
    `;
    tr.appendChild(tdTopic);

    SCALE_VALUES.forEach(v => {
      const td = document.createElement('td');
      const id = `q${idx}_${v}`;
      td.innerHTML = `
        <label class="radio-cell" for="${id}">
          <input type="radio" name="q${idx}" id="${id}" value="${v}">
          <span class="dot"></span>
        </label>
      `;
      tr.appendChild(td);
    });

    tbody.appendChild(tr);
  });

  // default date = today
  document.getElementById('evalDate').valueAsDate = new Date();

  const form = document.getElementById('evalForm');
  const btn = document.getElementById('submitBtn');
  const status = document.getElementById('status');
  const criterionEls = Array.from(document.querySelectorAll('.criterion'));
  const dateField = document.getElementById('field_evalDate');
  const departmentField = document.getElementById('field_department');

  criterionEls.forEach(el => {
    el.addEventListener('change', () => el.classList.remove('invalid'));
  });
  document.getElementById('evalDate').addEventListener('change', () => {
    dateField.classList.remove('invalid');
  });
  document.getElementById('department').addEventListener('input', () => {
    if (form.department.value.trim()) departmentField.classList.remove('invalid');
  });

  function validateForm() {
    let firstInvalid = null;
    const missingList = [];

    if (!form.evalDate.value) {
      dateField.classList.add('invalid');
      if (!firstInvalid) firstInvalid = dateField;
      missingList.push('วันที่ประเมิน');
    } else {
      dateField.classList.remove('invalid');
    }

    if (!form.department.value.trim()) {
      departmentField.classList.add('invalid');
      if (!firstInvalid) firstInvalid = departmentField;
      missingList.push('หน่วยงาน/ผู้รับวัสดุ');
    } else {
      departmentField.classList.remove('invalid');
    }

    criterionEls.forEach((el, i) => {
      const idx = i + 1;
      const checked = form.querySelector(`input[name="q${idx}"]:checked`);
      if (!checked) {
        el.classList.add('invalid');
        if (!firstInvalid) firstInvalid = el;
        missingList.push(`ข้อ ${idx}`);
      } else {
        el.classList.remove('invalid');
      }
    });

    return { valid: missingList.length === 0, firstInvalid, missingList };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = '';
    status.classList.remove('show');

    const { valid, firstInvalid } = validateForm();
    if (!valid) {
      firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    if (!SCRIPT_URL || SCRIPT_URL.indexOf('PASTE_YOUR_WEB_APP_URL_HERE') !== -1) {
      status.textContent = 'ยังไม่ได้ตั้งค่า SCRIPT_URL — ดูวิธีตั้งค่าใน Code.gs';
      status.classList.add('show', 'err');
      return;
    }

    const data = {
      evalDate: form.evalDate.value,
      department: form.department.value,
      comments: form.comments.value,
    };
    CRITERIA.forEach((text, i) => {
      const idx = i + 1;
      const val = form.querySelector(`input[name="q${idx}"]:checked`);
      data[`q${idx}_${text}`] = val ? val.value : '';
    });

    btn.disabled = true;
    btn.textContent = 'กำลังบันทึก...';

    try {
      const res = await fetch(SCRIPT_URL, {
        method: 'POST',
        headers: {'Content-Type': 'text/plain;charset=utf-8'},
        body: JSON.stringify(data)
      });
      status.textContent = 'บันทึกแบบประเมินเรียบร้อยแล้ว';
